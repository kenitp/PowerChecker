# Copy this file to .env and fill in your values.
# This file is read at compile time by build.rs via the `dotenv` crate
# (same role as the original load_credentials.py in the C++ / PlatformIO project).
#
# Usage:
#   cp .env.example .env
#   # edit .env
#   cargo build --release

WIFI_SSID=your_wifi_ssid
WIFI_PASS=your_wifi_password

# Home Assistant base URL.
# Only literal IPv4 addresses are supported (no DNS lookup at runtime).
HA_BASE_URL=http://192.168.0.1:8123

# Long-lived access token issued from the Home Assistant profile page.
HA_TOKEN=your_home_assistant_long_lived_access_token
